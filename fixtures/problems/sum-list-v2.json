{
  "schema_version": 1,
  "id": "sum-list-v2",
  "title": "Sum a list",
  "description": "Read a count n followed by n signed decimal integers and print their sum. The count is between 0 and 100 inclusive. Each value is between -10^18 and 10^18 inclusive. The empty list has sum zero; the result may exceed a signed 64-bit integer.",
  "input_format": "A nonnegative integer n followed by exactly n integers, all separated by ASCII whitespace. A final newline is optional.",
  "output_format": "Print a single decimal integer: the sum of the n values.",
  "runtime": "python-3.14.10",
  "limits": {
    "cpu_time_ms": 1000,
    "wall_time_ms": 3000,
    "memory_bytes": 134217728,
    "output_bytes": 1048576,
    "processes": 1
  },
  "examples": [
    {
      "input": "5\n1 -2 3 0 4\n",
      "output": "6\n"
    },
    {
      "input": "0\n",
      "output": "0\n"
    }
  ],
  "test_cases": [
    {
      "id": "empty",
      "position": 0,
      "input": "0\n",
      "expected_output": "0\n"
    },
    {
      "id": "one-zero",
      "position": 1,
      "input": "1\n0\n",
      "expected_output": "0\n"
    },
    {
      "id": "one-negative",
      "position": 2,
      "input": "1\n-8\n",
      "expected_output": "-8\n"
    },
    {
      "id": "positive",
      "position": 3,
      "input": "4\n1 2 3 4\n",
      "expected_output": "10\n"
    },
    {
      "id": "mixed-signs",
      "position": 4,
      "input": "5\n1 -2 3 0 4\n",
      "expected_output": "6\n"
    },
    {
      "id": "all-negative",
      "position": 5,
      "input": "3\n-3 -5 -7\n",
      "expected_output": "-15\n"
    },
    {
      "id": "large-values",
      "position": 6,
      "input": "4\n1000000000000000000 1000000000000000000 -1000000000000000000 7\n",
      "expected_output": "1000000000000000007\n"
    },
    {
      "id": "maximum-count",
      "position": 7,
      "input": "100\n1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000 1000000000000000000\n",
      "expected_output": "100000000000000000000\n"
    },
    {
      "id": "whitespace",
      "position": 8,
      "input": "3\t-5\n\n0 8",
      "expected_output": "3\n"
    }
  ]
}
